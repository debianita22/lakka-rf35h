#!/bin/sh
# rf35h-update - aggiornamento di sistema dalle release di GitHub.
#
#   rf35h-update run      se c'e' una release piu' nuova di quella installata,
#                         ne scarica il .tar e ne verifica dimensione e sha256,
#                         poi lo tiene da parte in /storage/.update/.rf35h-staged:
#                         pronto, ma l'init non lo vede
#   rf35h-update install  ricontrolla batteria (30%, o il caricatore) e spazio,
#                         sposta il .tar pronto in /storage/.update ed esce 0:
#                         chi chiama riavvia, e l'init di LibreELEC lo installa
#                         (KERNEL, SYSTEM, device tree e il loader known-good,
#                         che verify-image controlla in ogni release). ROM,
#                         salvataggi e impostazioni restano. Se non si puo',
#                         esce 1 con il motivo in una riga su stdout (il menu la
#                         mostra) e il .tar resta fuori da .update.
#   rf35h-update check    solo il controllo: esce 0 se c'e' un aggiornamento,
#                         1 se no, 2 se non si e' potuto controllare
#   rf35h-update status   la riga di stato, quella che mostra il menu
#   rf35h-update cancel   toglie l'aggiornamento scaricato, o quello a meta'
#   rf35h-update boot     all'avvio: com'e' andata l'installazione chiesta con
#                         "install", e lo stato di prima che non vale piu'
#
# Lo avvia il menu (Device Settings > System Update) attraverso
# rf35h-update.service, come lo scraper: un figlio di RetroArch morirebbe con
# lui, e "sta girando?" lo si chiede a systemd. Fermare il servizio (la stessa
# voce del menu) lascia il file a meta': il giro dopo riprende da li'. Con un
# aggiornamento pronto la voce chiama "install", e riavvia solo se esce 0.
#
# Perche' "install" a parte: all'avvio l'init installa qualunque aggiornamento
# trovi in /storage/.update, senza chiedere, e riscrive KERNEL e poi SYSTEM
# (~650 MB): se la batteria muore li', la card va riscritta. La batteria si
# guarda quindi subito prima del riavvio, non quando si scarica, e fino ad
# allora il .tar sta in .update/.rf35h-staged. L'init cerca solo in cima a
# .update (KERNEL con SYSTEM, il primo *.tar, *.img.gz o *.img), e la sua
# pulizia (rm -rf .update/[0-9a-zA-Z]*, poi .tmp, .nocheck e .nocompat) non
# tocca una cartella col punto: li' dentro il .tar non viene ne' installato
# ne' cancellato. Un .tar gia' in .update con update.ready (lo scaricava cosi'
# la v1.0.0) va come prima: "install" lo lascia dov'e', e se rifiuta lo mette
# da parte.
#
# update.ready: il .tar pronto (la prima riga, quella che legge il menu) e la
# sua versione. update.install: la versione e il .tar che "install" ha messo in
# .update. L'init cancella il .tar sia quando lo installa sia quando fallisce:
# al riavvio "boot" sa com'e' andata dalla versione che gira, e un'installazione
# fallita la dice nella riga del menu invece di tornare in silenzio a
# "installed: <la vecchia>".
#
# Da dove: update.txt dell'ultima release (le pre-release no) del repository
# scritto alla build in /usr/share/rf35h/update-repo, cioe'
#   https://github.com/<repo>/releases/latest/download/update.txt
# e in /storage/.config/rf35h/update.conf si puo' cambiare:
#   REPO=utente/repository    un altro repository
#   TAG=v1.2.0                una release precisa (anche una pre-release, o una
#                             vecchia per tornare indietro)
#   URL=https://.../update.txt
# update.txt (lo scrive la CI): version, tar, url, sha256, size.
#
# Solo in avanti: dall'ultima release si prende una versione solo se e' piu'
# nuova di quella installata (vX.Y.Z; una pre-release viene prima della sua
# release, v1.2.0-rc1 < v1.2.0). Se l'ultima release e' piu' vecchia (una
# correzione per una serie vecchia, o uno sbaglio) le console restano dove
# sono. Con TAG o URL in update.conf si prende quella e basta, anche piu'
# vecchia: l'ha chiesta l'utente. Una build personale (VERSION non vX.Y.Z,
# come devel-...) prende l'ultima release, come prima.
#
# GTA III (re3) non e' mai in una release. Se la console lo ha da una build
# personale, prima di finire lo copia in /storage (cores e system), dove
# l'aggiornamento non arriva; "boot" toglie la copia quando l'immagine lo
# riporta da se'.
set -u

STATE="${RF35H_STATE_DIR:-/storage/.config/rf35h}"
UPDATE_DIR="${RF35H_UPDATE_DIR:-/storage/.update}"
OS_RELEASE="${RF35H_OS_RELEASE:-/etc/os-release}"
REPO_FILE="${RF35H_UPDATE_REPO_FILE:-/usr/share/rf35h/update-repo}"
PS_DIR="${RF35H_PS_DIR:-/sys/class/power_supply}"
NTP_SYNCED="${RF35H_NTP_SYNCED:-/run/systemd/timesync/synchronized}"
LOCK="${RF35H_UPDATE_LOCK:-/run/rf35h-update.lock}"
LIBRETRO="${RF35H_LIBRETRO_DIR:-/usr/lib/libretro}"
RA_SYSTEM="${RF35H_RA_SYSTEM_DIR:-/usr/share/retroarch/system}"
STORAGE="${RF35H_STORAGE:-/storage}"
CURL="${RF35H_CURL:-curl}"
DEFAULT_REPO="debianita22/lakka-rf35h"
# batteria minima senza alimentatore: un aggiornamento interrotto all'avvio
# lascia la card da riscrivere
MIN_BATTERY=30

# il .tar verificato, finche' non lo si installa (vedi sopra)
STAGE="${UPDATE_DIR}/.rf35h-staged"
STATUS="${STATE}/update.status"
READY="${STATE}/update.ready"
MARK="${STATE}/update.install"
RE3_MARK="${STATE}/re3-preserved"
INFO="${STATE}/update.info"

say() { echo "rf35h-update: $*" >&2; }
# la riga del menu: in inglese come le altre di Device Settings, al massimo
# ~90 caratteri (una riga del sottotitolo)
status() {
	mkdir -p "${STATE}" 2>/dev/null
	printf '%s\n' "$*" > "${STATUS}.tmp" 2>/dev/null && mv -f "${STATUS}.tmp" "${STATUS}" 2>/dev/null
	# da un terminale (ssh, lakka-update) anche a schermo, l'avanzamento
	# sempre sulla stessa riga
	if [ -t 2 ]; then
		case "$*" in
			downloading*) printf '\r%s ' "$*" >&2 ;;
			*)            printf '\r%s\n' "$*" >&2 ;;
		esac
	fi
}
# nel journal (dal servizio) la stessa riga; a un terminale basta lo stato
fail() { status "error: $1"; [ -t 2 ] || say "$1"; exit 2; }

# una riga "CHIAVE=valore" (con o senza virgolette) da un file
kv() { sed -n "s/^$1=[\"']\{0,1\}\([^\"']*\)[\"']\{0,1\}[[:space:]]*\$/\1/p" "$2" 2>/dev/null | head -1; }

installed_version() { kv VERSION "${OS_RELEASE}"; }

# da dove leggere update.txt
# (le funzioni chiamate dentro $(...) girano in una subshell: le loro
# variabili non toccano quelle di chi le chiama; le altre usano nomi propri)
source_url() {
	_conf="${STATE}/update.conf"
	_url="$(kv URL "${_conf}")"
	if [ -n "${_url}" ]; then echo "${_url}"; return 0; fi
	_repo="$(kv REPO "${_conf}")"
	if [ -z "${_repo}" ] && [ -r "${REPO_FILE}" ]; then IFS= read -r _repo < "${REPO_FILE}" || true; fi
	_repo="${_repo:-${DEFAULT_REPO}}"
	_tag="$(kv TAG "${_conf}")"
	if [ -n "${_tag}" ]; then
		echo "https://github.com/${_repo}/releases/download/${_tag}/update.txt"
	else
		echo "https://github.com/${_repo}/releases/latest/download/update.txt"
	fi
}

# update.conf nomina una release precisa (TAG o URL): l'ha scelta l'utente
explicit_source() {
	[ -n "$(kv TAG "${STATE}/update.conf")" ] || [ -n "$(kv URL "${STATE}/update.conf")" ]
}

# Esce 0 se la versione $1 e' piu' nuova di $2, 1 se no, 2 se $1 non e'
# vX.Y.Z[-pre-release][+build], 3 se non lo e' $2. Le tre cifre come numeri;
# senza pre-release viene dopo che con (v1.2.0-rc1 < v1.2.0); due
# pre-release pezzo per pezzo fra i ".", i numeri come numeri e "rc10" come
# "rc" e poi 10 (rc2 < rc10); +build non conta. Non "sort -V": la busybox
# della console lo ha, ma mette v1.2.0 prima di v1.2.0-rc1.
version_newer() {
	awk -v a="$1" -v b="$2" '
	function parse(v, R,   p, n) {
		sub(/^[vV]/, "", v); sub(/[+].*$/, "", v)
		if (v !~ /^[0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z.-]+)?$/) return 0
		p = index(v, "-")
		R["pre"] = ""
		if (p) { R["pre"] = substr(v, p + 1); v = substr(v, 1, p - 1) }
		split(v, n, ".")
		R[1] = n[1] + 0; R[2] = n[2] + 0; R[3] = n[3] + 0
		return 1
	}
	function cmpid(x, y,   xa, ya, xn, yn) {
		if (x ~ /^[0-9]+$/ && y ~ /^[0-9]+$/) return (x + 0 < y + 0) ? -1 : (x + 0 > y + 0)
		if (x ~ /^[0-9]+$/) return -1
		if (y ~ /^[0-9]+$/) return 1
		xa = x; ya = y; xn = -1; yn = -1
		if (match(x, /[0-9]+$/)) { xa = substr(x, 1, RSTART - 1); xn = substr(x, RSTART) + 0 }
		if (match(y, /[0-9]+$/)) { ya = substr(y, 1, RSTART - 1); yn = substr(y, RSTART) + 0 }
		if (xa != ya) return (xa < ya) ? -1 : 1
		return (xn < yn) ? -1 : (xn > yn)
	}
	function cmppre(x, y,   nx, ny, px, py, i, c) {
		if (x == y) return 0
		if (x == "") return 1
		if (y == "") return -1
		nx = split(x, px, "."); ny = split(y, py, ".")
		for (i = 1; i <= nx && i <= ny; i++) if ((c = cmpid(px[i], py[i])) != 0) return c
		return (nx < ny) ? -1 : (nx > ny)
	}
	BEGIN {
		if (!parse(b, B)) exit 3
		if (!parse(a, A)) exit 2
		for (i = 1; i <= 3; i++) if (A[i] != B[i]) { r = (A[i] > B[i]) ? 0 : 1; exit r }
		r = (cmppre(A["pre"], B["pre"]) > 0) ? 0 : 1
		exit r
	}'
}

# KB liberi sulla partizione di un percorso
free_kb() { df -Pk "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'; }

# la dimensione di un file, 0 se non c'e'. Da ls e non da "wc -c": la busybox
# conta i byte leggendo il file, 600 MB ogni 2 secondi dalla SD. stat -c qui
# non c'e' (FEATURE_STAT_FORMAT spenta).
fsize() {
	# shellcheck disable=SC2012  # un file nostro, nome senza sorprese
	_s="$(ls -ln "$1" 2>/dev/null | awk '{ print $5 }')"
	case "${_s}" in ''|*[!0-9]*) echo 0 ;; *) echo "${_s}" ;; esac
}

# la batteria: "ok", oppure la carica in % se e' sotto il minimo e scollegata
battery_check() {
	for _ps in "${PS_DIR}"/*; do
		[ -r "${_ps}/type" ] || continue
		IFS= read -r _t < "${_ps}/type" || continue
		[ "${_t}" = Battery ] || continue
		_cap=""; _st=""
		[ -r "${_ps}/capacity" ] && IFS= read -r _cap < "${_ps}/capacity"
		[ -r "${_ps}/status" ] && IFS= read -r _st < "${_ps}/status"
		case "${_st}" in Charging|Full) echo ok; return 0 ;; esac
		case "${_cap}" in ''|*[!0-9]*) echo ok; return 0 ;; esac
		if [ "${_cap}" -lt "${MIN_BATTERY}" ]; then echo "${_cap}"; else echo ok; fi
		return 0
	done
	echo ok
}

# Il .tar pronto, se c'e' davvero: la prima riga di update.ready, un .tar in
# .rf35h-staged oppure gia' in .update (dopo "install", o della v1.0.0).
ready_file() {
	[ -f "${READY}" ] || return 1
	_r=""; IFS= read -r _r < "${READY}"
	_n="${_r##*/}"
	case "${_n}" in ''|.*|*[!A-Za-z0-9._+-]*) return 1 ;; *.tar) ;; *) return 1 ;; esac
	[ "${_r}" = "${STAGE}/${_n}" ] || [ "${_r}" = "${UPDATE_DIR}/${_n}" ] || return 1
	[ -f "${_r}" ] || return 1
	echo "${_r}"
}
# la sua versione: la seconda riga di update.ready, o update.info se parla
# dello stesso .tar (update.ready della v1.0.0 ha solo la prima)
ready_version() {
	_v="$(sed -n 2p "${READY}" 2>/dev/null)"
	case "${_v}" in *[!A-Za-z0-9._+-]*) _v="" ;; esac
	if [ -z "${_v}" ] && [ "$(kv tar "${INFO}")" = "${1##*/}" ]; then _v="$(kv version "${INFO}")"; fi
	echo "${_v}"
}
set_ready() {   # .tar versione
	mkdir -p "${STATE}" && printf '%s\n%s\n' "$1" "$2" > "${READY}.tmp" && mv -f "${READY}.tmp" "${READY}"
}

# Senza orologio tamponato la data giusta arriva solo dall'NTP. TLS con una
# data sbagliata fallisce: si aspetta un po' la sincronizzazione, poi si prova
# comunque (curl dira' se il certificato non torna).
wait_clock() {
	_n=0
	while [ ! -e "${NTP_SYNCED}" ] && [ "${_n}" -lt "${RF35H_CLOCK_WAIT:-15}" ]; do
		sleep 2; _n=$((_n + 1))
	done
}

# curl con le opzioni di tutti i giri; il codice d'uscita e' quello di curl
fetch() { "${CURL}" -fsSL --connect-timeout 20 --retry 2 "$@"; }

curl_reason() {
	case "$1" in
		6|7)         echo "no network" ;;
		28)          echo "network too slow (timeout)" ;;
		35|51|53|54|58|59|60|77|80|82|83|90|91)
		             echo "secure connection failed: is the clock right? (Network Time)" ;;
		22)          echo "not found on the server (HTTP error)" ;;
		23)          echo "cannot write to /storage" ;;
		*)           echo "download failed (curl $1)" ;;
	esac
}

# Legge update.txt e lo controlla campo per campo: arriva dalla rete, e i suoi
# valori finiscono in nomi di file e nella riga di curl.
read_info() {
	U_VERSION="$(kv version "$1")"; U_TAR="$(kv tar "$1")"; U_URL="$(kv url "$1")"
	U_SHA="$(kv sha256 "$1")"; U_SIZE="$(kv size "$1")"
	case "${U_VERSION}" in ''|*[!A-Za-z0-9._+-]*) return 1 ;; esac
	case "${U_TAR}" in ''|*/*|.*|*[!A-Za-z0-9._+-]*) return 1 ;; *.tar) ;; *) return 1 ;; esac
	case "${U_URL}" in https://*) ;; *) return 1 ;; esac
	case "${U_URL}" in *[!A-Za-z0-9._~:/?#@!\$\&\'\(\)*+,\;=%-]*) return 1 ;; esac
	case "${U_SIZE}" in ''|*[!0-9]*) return 1 ;; esac
	[ "${#U_SHA}" = 64 ] || return 1
	case "${U_SHA}" in *[!0-9a-f]*) return 1 ;; esac
	return 0
}

# re3 dalla build personale in /storage, prima che l'aggiornamento lo tolga
preserve_re3() {
	[ -f "${LIBRETRO}/re3_libretro.so" ] || return 0
	mkdir -p "${STORAGE}/cores" "${STORAGE}/system" || return 1
	cp -f "${LIBRETRO}/re3_libretro.so" "${STORAGE}/cores/" || return 1
	[ -f "${LIBRETRO}/re3_libretro.info" ] && cp -f "${LIBRETRO}/re3_libretro.info" "${STORAGE}/cores/"
	if [ -d "${RA_SYSTEM}/re3" ] && [ ! -e "${STORAGE}/system/re3" ]; then
		cp -a "${RA_SYSTEM}/re3" "${STORAGE}/system/re3" || return 1
		echo system > "${RE3_MARK}"
	else
		echo cores > "${RE3_MARK}"
	fi
	say "GTA III (re3) copiato in ${STORAGE}/cores: le release non lo hanno"
}

cmd_boot() {
	cur="$(installed_version)"
	# Un'installazione chiesta con "install": com'e' andata. Conta solo se
	# update.ready dice ancora lo stesso .tar (un marcatore rimasto da un giro
	# vecchio, o da una versione che non lo conosce, no).
	if [ -f "${MARK}" ]; then
		m_ver=""; m_tar=""; t=""
		{ IFS= read -r m_ver; IFS= read -r m_tar; } < "${MARK}"
		[ -f "${READY}" ] && { IFS= read -r t < "${READY}" || :; }
		if [ -z "${m_ver}" ] || [ -z "${m_tar}" ] || [ "${t}" != "${m_tar}" ]; then
			rm -f "${MARK}"
		elif [ "${m_ver}" = "${cur}" ]; then
			rm -f "${MARK}" "${READY}" "${STATUS}"
			rmdir "${STAGE}" 2>/dev/null
			say "${cur} installata"
		elif [ -f "${m_tar}" ]; then
			# ancora in .update: l'init non e' ancora passato (boot lanciato a
			# mano), lo installa al prossimo avvio
			:
		elif [ -f "${STAGE}/${m_tar##*/}" ]; then
			# spenta a meta' di "install", prima di spostarlo: non e' successo
			# niente, resta pronto
			rm -f "${MARK}"
			set_ready "${STAGE}/${m_tar##*/}" "${m_ver}"
		else
			# l'init l'ha preso e cancellato, ma gira ancora la versione di
			# prima: il perche' l'ha scritto sullo schermo durante l'avvio
			rm -f "${MARK}" "${READY}"
			status "error: install of ${m_ver} failed: select to try again"
			say "installazione di ${m_ver} non riuscita, gira ancora ${cur:-?}"
		fi
	fi
	# L'aggiornamento scaricato e' stato installato (o tolto): "ready" e una
	# riga di avanzamento rimasta da un giro interrotto non valgono piu'.
	if [ -f "${READY}" ]; then
		IFS= read -r t < "${READY}" || t=""
		if [ -z "${t}" ] || [ ! -f "${t}" ]; then rm -f "${READY}" "${STATUS}"; fi
	fi
	if [ -f "${STATUS}" ] && [ ! -f "${READY}" ]; then
		case "$(cat "${STATUS}" 2>/dev/null)" in
			ready*|checking*|downloading*|verifying*) rm -f "${STATUS}" ;;
			# fallita, ma intanto installata in un altro modo
			"error: install of ${cur} failed"*) [ -n "${cur}" ] && rm -f "${STATUS}" ;;
		esac
	fi
	# re3 copiato da noi, e l'immagine ora lo ha di suo: la copia lo
	# nasconderebbe (in /tmp/cores vince /storage/cores)
	if [ -f "${RE3_MARK}" ] && [ -f "${LIBRETRO}/re3_libretro.so" ]; then
		rm -f "${STORAGE}/cores/re3_libretro.so" "${STORAGE}/cores/re3_libretro.info"
		[ "$(cat "${RE3_MARK}")" = system ] && rm -rf "${STORAGE}/system/re3"
		rm -f "${RE3_MARK}"
		say "copia di re3 in ${STORAGE} tolta: l'immagine lo ha di nuovo"
	fi
	return 0
}

cmd_cancel() {
	rm -f "${UPDATE_DIR}"/*.part "${UPDATE_DIR}/.rf35h-update.tmp" "${STAGE}"/*.part "${STAGE}"/*.tar
	if t="$(ready_file)"; then rm -f "${t}"; fi
	rm -f "${READY}" "${MARK}"
	rmdir "${STAGE}" 2>/dev/null
	status "cancelled"
	echo "aggiornamento tolto"
}

# install: il motivo del no in una riga su stdout, ed esce 1
refuse() { echo "$1"; exit 1; }

cmd_install() {
	# non durante un controllo o un download (il menu e un ssh)
	if command -v flock >/dev/null 2>&1; then
		exec 9> "${LOCK}" || refuse "cannot create ${LOCK}"
		flock -n 9 || refuse "an update check or download is running"
	fi
	f="$(ready_file)" || refuse "no update ready: select System Update to download it"
	n="${f##*/}"
	v="$(ready_version "${f}")"
	final="${UPDATE_DIR}/${n}"

	why=""
	bat="$(battery_check)"
	if [ "${bat}" != ok ]; then
		why="battery at ${bat}%: connect the charger"
	else
		# l'init estrae il .tar accanto a se' prima di installarlo
		need=$(( $(fsize "${f}") / 1024 + 102400 ))
		[ "$(free_kb "${UPDATE_DIR}")" -ge "${need}" ] 2>/dev/null \
			|| why="not enough space in /storage: $(( need / 1024 )) MB needed"
	fi
	if [ -n "${why}" ]; then
		# gia' in .update (v1.0.0, o un "install" senza riavvio): da parte,
		# o l'init lo installerebbe al primo avvio qualunque
		if [ "${f}" = "${final}" ] && mkdir -p "${STAGE}" && mv -f "${f}" "${STAGE}/${n}"; then
			set_ready "${STAGE}/${n}" "${v}"
			rm -f "${MARK}"
			sync
		fi
		[ -t 1 ] || say "non installo ${v:-${n}}: ${why}"
		refuse "${why}"
	fi

	# un solo aggiornamento in .update: l'init applica il primo che trova
	for t in "${UPDATE_DIR}"/*.tar "${UPDATE_DIR}"/*.img "${UPDATE_DIR}"/*.img.gz; do
		[ -e "${t}" ] || continue
		[ "${t}" = "${final}" ] && continue
		rm -f "${t}"
	done
	# Prima il marcatore e update.ready, poi il .tar: se si spegne qui a meta',
	# "boot" vede dove e' rimasto. Senza versione niente marcatore: al
	# riavvio non si saprebbe dire se e' andata.
	rm -f "${MARK}"
	if [ -n "${v}" ] && ! { printf '%s\n%s\n' "${v}" "${final}" > "${MARK}.tmp" && mv -f "${MARK}.tmp" "${MARK}"; }; then
		refuse "cannot write ${STATE}"
	fi
	set_ready "${final}" "${v}" || { rm -f "${MARK}"; refuse "cannot write ${STATE}"; }
	if [ "${f}" != "${final}" ] && ! mv -f "${f}" "${final}"; then
		rm -f "${MARK}"; set_ready "${f}" "${v}"
		refuse "cannot move the update to ${UPDATE_DIR}"
	fi
	sync
	say "${v:-${n}} in ${UPDATE_DIR}: l'init lo installa al prossimo avvio"
	return 0
}

# check: la release da installare, in U_*. 0 = c'e', 1 = niente da installare
cmd_check() {
	src="$(source_url)"
	mkdir -p "${STATE}" || fail "cannot write ${STATE}"
	tmp="${STATE}/update.txt.tmp"
	status "checking..."
	wait_clock
	rc=0; fetch --max-time 60 -o "${tmp}" "${src}" || rc=$?
	if [ "${rc}" != 0 ]; then
		rm -f "${tmp}"
		fail "$(curl_reason "${rc}")"
	fi
	if ! read_info "${tmp}"; then
		rm -f "${tmp}"
		fail "invalid update.txt from ${src}"
	fi
	mv -f "${tmp}" "${INFO}"
	cur="$(installed_version)"
	if [ "${U_VERSION}" = "${cur}" ]; then
		status "up to date (${cur})"
		return 1
	fi
	# solo in avanti, salvo una release chiesta con TAG o URL (vedi sopra).
	# (nv e non rc: rc e' di chi chiama)
	if ! explicit_source; then
		nv=0; version_newer "${U_VERSION}" "${cur}" || nv=$?
		case "${nv}" in
			0|3) ;;
			1)
				status "up to date (${cur})"
				say "l'ultima release, ${U_VERSION}, non e' piu' nuova di ${cur}: per installarla TAG=${U_VERSION} in update.conf"
				return 1 ;;
			*)
				status "up to date (${cur})"
				say "l'ultima release, ${U_VERSION}, non e' una versione vX.Y.Z: si installa solo con TAG= o URL= in update.conf"
				return 1 ;;
		esac
	fi
	say "installata ${cur:-?}, disponibile ${U_VERSION}"
	return 0
}

on_term() {
	[ -n "${CURL_PID:-}" ] && kill "${CURL_PID}" 2>/dev/null
	status "stopped: select to resume the download"
	exit 143
}

cmd_run() {
	# un giro alla volta (il menu e un ssh potrebbero sovrapporsi)
	if command -v flock >/dev/null 2>&1; then
		exec 9> "${LOCK}" || fail "cannot create ${LOCK}"
		flock -n 9 || { say "gia' in corso"; exit 2; }
	fi
	trap on_term TERM INT

	if t="$(ready_file)"; then
		status "ready: $(ready_version "${t}"), select to restart and install"
		return 0
	fi
	rm -f "${READY}" "${MARK}"

	rc=0; cmd_check || rc=$?
	[ "${rc}" = 0 ] || return 0

	bat="$(battery_check)"
	[ "${bat}" = ok ] || fail "battery at ${bat}%: charge it or plug it in"

	mkdir -p "${STAGE}" || fail "cannot create ${STAGE}"
	target="${STAGE}/${U_TAR}"
	part="${target}.part"
	# Niente altri aggiornamenti: in .update l'init applica il primo .tar che
	# trova, e uno vecchio lasciato li' passerebbe davanti; in .rf35h-staged
	# solo questo, anche a meta'.
	for t in "${UPDATE_DIR}"/*.tar "${UPDATE_DIR}"/*.img "${UPDATE_DIR}"/*.img.gz "${UPDATE_DIR}"/*.part "${STAGE}"/*; do
		[ -e "${t}" ] || continue
		[ "${t}" = "${part}" ] && continue
		[ "${t}" = "${target}" ] && continue
		rm -f "${t}"
	done
	# gia' scaricato ma update.ready mai scritto (spenta li'): si riverifica
	[ -f "${target}" ] && mv -f "${target}" "${part}"

	have="$(fsize "${part}")"
	if [ "${have}" -gt "${U_SIZE}" ]; then rm -f "${part}"; have=0; fi
	# il .tar, e l'init lo estrae accanto prima di installarlo: due volte la
	# dimensione, piu' un margine
	need=$(( (U_SIZE - have) / 1024 + U_SIZE / 1024 + 102400 ))
	[ "$(free_kb "${UPDATE_DIR}")" -ge "${need}" ] 2>/dev/null \
		|| fail "not enough space in /storage: $(( need / 1024 )) MB needed"

	# Il download in background, per scrivere l'avanzamento ogni 2 s. Niente
	# --retry di curl: i tentativi li fa questo ciclo, sempre con -C -, cosi'
	# ognuno riprende da dove si era fermato il precedente.
	tot=$(( U_SIZE / 1048576 ))
	tries=0
	while [ "${have}" -lt "${U_SIZE}" ]; do
		tries=$((tries + 1))
		say "scarico ${U_VERSION} (${tot} MB), tentativo ${tries}"
		"${CURL}" -fL --connect-timeout 20 --speed-limit 2048 --speed-time 60 \
			-s -C - -o "${part}" "${U_URL}" &
		CURL_PID=$!
		while kill -0 "${CURL_PID}" 2>/dev/null; do
			have="$(fsize "${part}")"
			status "downloading ${U_VERSION}: $(( have * 100 / U_SIZE ))% ($(( have / 1048576 ))/${tot} MB)"
			sleep 2
		done
		rc=0; wait "${CURL_PID}" || rc=$?
		CURL_PID=""
		have="$(fsize "${part}")"
		[ "${rc}" = 0 ] && break
		case "${rc}" in
			# il server non riprende da dove eravamo: da capo
			33|36) rm -f "${part}"; have=0 ;;
			# un 4xx/5xx non cambia riprovando subito; nemmeno un certificato
			22|35|51|53|54|58|59|60|77|80|82|83|90|91) fail "$(curl_reason "${rc}")" ;;
		esac
		[ "${tries}" -lt 4 ] || fail "$(curl_reason "${rc}")"
		sleep 5
	done

	status "verifying ${U_VERSION}..."
	have="$(fsize "${part}")"
	if [ "${have}" != "${U_SIZE}" ]; then
		rm -f "${part}"
		fail "wrong size (${have} instead of ${U_SIZE}), deleted: try again"
	fi
	sum="$(sha256sum "${part}" | cut -d' ' -f1)"
	if [ "${sum}" != "${U_SHA}" ]; then
		rm -f "${part}"
		fail "checksum mismatch, deleted: try again"
	fi

	preserve_re3 || fail "cannot copy GTA III (re3) to ${STORAGE}"

	mv -f "${part}" "${target}" || fail "cannot write ${target}"
	sync
	set_ready "${target}" "${U_VERSION}" || fail "cannot write ${READY}"
	status "ready: ${U_VERSION}, select to restart and install"
	say "pronto: ${target}. Per installarlo: rf35h-update install, poi riavvia."
	return 0
}

case "${1:-}" in
	run)     cmd_run ;;
	install) cmd_install ;;
	check)
		rc=0; cmd_check || rc=$?
		if [ "${rc}" = 0 ]; then echo "disponibile ${U_VERSION} (installata $(installed_version))"; fi
		exit "${rc}" ;;
	status)
		if [ -s "${STATUS}" ]; then cat "${STATUS}"; else echo "installed: $(installed_version)"; fi ;;
	cancel)  cmd_cancel ;;
	boot)    cmd_boot ;;
	*)
		echo "uso: rf35h-update run|install|check|status|cancel|boot" >&2
		exit 2 ;;
esac
