[Unit]
Description=XiFan RF35H core updates (single cores from the "cores" release)
# Non si abilita: la avvia il menu di RetroArch (Device Settings > Core
# Updates), che prima scrive cosa vuole in /storage/.config/rf35h/cores.queue
# (refresh, all, o nomi di core). Una unit e non un figlio di RetroArch, come
# rf35h-update.service: "sta girando?" lo si chiede a systemd, e lo stato per
# core sta in cores.status. Ogni core va in /storage/cores: RetroArch lo usa
# al prossimo caricamento di quel core, senza riavviare.
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rf35h-cores run
Nice=10
TimeoutStopSec=15
