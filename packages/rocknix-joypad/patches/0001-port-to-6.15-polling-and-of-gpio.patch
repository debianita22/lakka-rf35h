--- a/of_gpio_compat.h	2026-09-14 15:02:02.066464576 +0000
+++ b/of_gpio_compat.h	2026-09-14 18:31:43.671351562 +0000
@@ -0,0 +1,47 @@
+/* devaOS: of_get_named_gpio_flags() and of_get_gpio_flags() were removed
+ * from mainline (the legacy integer-GPIO OF helpers). This driver needs the
+ * flags to learn active-low. Rebuilt here the way the kernel implemented
+ * them - resolve the phandle with args, take the flags cell, and map the
+ * gpio number through the modern helper - so the driver source stays as
+ * upstream wrote it. */
+#ifndef ROCKNIX_OF_GPIO_COMPAT_H
+#define ROCKNIX_OF_GPIO_COMPAT_H
+#include <linux/version.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
+
+#ifndef OF_GPIO_ACTIVE_LOW
+enum of_gpio_flags { OF_GPIO_ACTIVE_LOW = 0x1 };
+#endif
+
+static inline int rocknix_of_get_named_gpio_flags(const struct device_node *np,
+		const char *propname, int index, enum of_gpio_flags *flags)
+{
+	struct of_phandle_args args;
+	int gpio, ret;
+
+	gpio = of_get_named_gpio(np, propname, index);
+	if (gpio < 0)
+		return gpio;
+	if (flags) {
+		*flags = 0;
+		ret = of_parse_phandle_with_args(np, propname, "#gpio-cells", index, &args);
+		if (!ret) {
+			/* Rockchip and most controllers: cell 0 = pin, cell 1 = flags. */
+			if (args.args_count >= 2 && (args.args[1] & 1))
+				*flags |= OF_GPIO_ACTIVE_LOW;
+			of_node_put(args.np);
+		}
+	}
+	return gpio;
+}
+
+static inline int rocknix_of_get_gpio_flags(const struct device_node *np,
+		int index, enum of_gpio_flags *flags)
+{
+	return rocknix_of_get_named_gpio_flags(np, "gpios", index, flags);
+}
+
+#define of_get_named_gpio_flags rocknix_of_get_named_gpio_flags
+#define of_get_gpio_flags       rocknix_of_get_gpio_flags
+#endif
