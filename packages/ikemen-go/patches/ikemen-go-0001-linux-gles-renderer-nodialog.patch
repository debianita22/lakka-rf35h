 // TTF font loading
 func LoadFntTtf(f *Fnt, fontfile string, filename string, height int32) {
@@ -69,6 +60,13 @@ func selectRenderer(cfgVal string) (Renderer, FontRenderer) {
 	case "Vulkan 1.3":
 		gfx = &Renderer_VK{}
 		gfxFont = &FontRenderer_VK{}
+	case "OpenGL ES 3.2":
+		// Only present when built with the "gles" tag (util_gles_desktop.go).
+		if gfx, gfxFont = newRendererGLES32(); gfx == nil {
+			fmt.Printf("Error: RenderMode '%s' not compiled in. Defaulting to OpenGL 3.3.\n", cfgVal)
+			gfx = &Renderer_GL33{}
+			gfxFont = &FontRenderer_GL33{}
+		}
 	default:
 		fmt.Printf("Error: Invalid RenderMode '%s'. Defaulting to OpenGL 3.3.\n", cfgVal)
 		gfx = &Renderer_GL33{}
@@ -78,6 +76,19 @@ func selectRenderer(cfgVal string) (Renderer, FontRenderer) {
 	return gfx, gfxFont
 }
 
+// rendererAvailable reports whether a RenderMode value is compiled into this
+// binary. The options menu uses it to hide renderers that cannot be selected.
+func rendererAvailable(name string) bool {
+	switch name {
+	case "OpenGL 3.3", "Vulkan 1.3":
+		return true
+	case "OpenGL ES 3.2":
+		gfx, _ := newRendererGLES32()
+		return gfx != nil
+	}
+	return false
+}
+
 func Logcat(s string) {
 	fmt.Println(s)
 }
