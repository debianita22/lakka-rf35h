new file mode 100644
index 0000000..8314cc8
--- /dev/null
+++ b/src/util_nogles_desktop.go
@@ -0,0 +1,8 @@
+//go:build !gles && !android && !raw
+
+package main
+
+// Without the "gles" tag the OpenGL ES renderer is not compiled in.
+func newRendererGLES32() (Renderer, FontRenderer) {
+	return nil, nil
+}
