diff --git a/external/script/options.lua b/external/script/options.lua
index e00db22..76e4259 100644
--- a/external/script/options.lua
+++ b/external/script/options.lua
@@ -174,7 +174,7 @@ options.t_itemname = {
 			--modifyGameOption('Debug.SpeedTest', 100)
 			-- This is platform dependent now
 			local runtimeOS = getRuntimeOS()
-			if runtimeOS == 'android' then
+			if runtimeOS == 'android' or isRendererAvailable('OpenGL ES 3.2') then
 				modifyGameOption('Video.RenderMode', 'OpenGL ES 3.2')
 			else
 				modifyGameOption('Video.RenderMode', "OpenGL 3.3")
@@ -1787,9 +1787,15 @@ function options.f_start()
 	end
 	-- Runtime platform filtering
 	local runtimeOS = getRuntimeOS()
-	local excluded = {gles32 = true}
+	local excluded = {}
 	if runtimeOS == 'android' then
-		excluded = {keyboard = true, gl33 = true, vk13 = true}
+		excluded.keyboard = true
+	end
+	-- Only offer the renderers compiled into this binary
+	for k, v in pairs({gles32 = 'OpenGL ES 3.2', gl33 = 'OpenGL 3.3', vk13 = 'Vulkan 1.3'}) do
+		if not isRendererAvailable(v) then
+			excluded[k] = true
+		end
 	end
 	main.f_pruneMenu(options.menu, excluded)
 	main.f_prunePointers(options.t_vardisplayPointers, excluded)
