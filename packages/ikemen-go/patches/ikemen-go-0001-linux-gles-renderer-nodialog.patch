diff --git a/src/util_dialog_stderr.go b/src/util_dialog_stderr.go
new file mode 100644
index 0000000..7e6d2bd
--- /dev/null
+++ b/src/util_dialog_stderr.go
@@ -0,0 +1,19 @@
+//go:build !raw && !android && nodialog
+
+package main
+
+import (
+	"fmt"
+	"os"
+)
+
+// Message box implementation for builds without GTK (tag "nodialog"), e.g.
+// embedded Linux handhelds running a bare Wayland compositor: there is no
+// desktop to show a dialog on, so the text goes to stderr (and the log).
+func ShowInfoDialog(message, title string) {
+	fmt.Fprintf(os.Stderr, "%s\n\n%s\n", title, message)
+}
+
+func ShowErrorDialog(message string) {
+	fmt.Fprintf(os.Stderr, "I.K.E.M.E.N Error\n\n%s\n", message)
+}
diff --git a/src/util_gles_desktop.go b/src/util_gles_desktop.go
new file mode 100644
index 0000000..7a9c27a
--- /dev/null
+++ b/src/util_gles_desktop.go
@@ -0,0 +1,21 @@
+//go:build gles && !android && !raw
+
+package main
+
+import (
+	"unsafe"
+
+	"github.com/veandco/go-sdl2/sdl"
+)
+
+// OpenGL ES 3.2 renderer on desktop Linux (tag "gles"), for ARM boards whose
+// driver exposes GLES but only an old desktop GL (e.g. Panfrost on Mali).
+// SDL owns the EGL display, so function pointers come from SDL: it asks
+// eglGetProcAddress first and falls back to the GLES library it loaded.
+func eglGetProcAddress(name string) unsafe.Pointer {
+	return sdl.GLGetProcAddress(name)
+}
+
+func newRendererGLES32() (Renderer, FontRenderer) {
+	return &Renderer_GLES32{}, &FontRenderer_GLES32{}
+}
