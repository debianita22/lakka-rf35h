--- a/inc/compat_6_15.h	2026-09-14 15:02:02.066464576 +0000
+++ b/inc/compat_6_15.h	2026-09-14 18:32:39.888680951 +0000
@@ -0,0 +1,14 @@
+/* devaOS: API renames between the kernel this driver was written for (6.12)
+ * and 6.15. del_timer/del_timer_sync were dropped in 6.15 in favour of
+ * timer_delete/timer_delete_sync (same semantics). Included from every
+ * translation unit via ccflags-y -include, so the driver sources stay
+ * unmodified and a future upstream rename is a one-line change here. */
+#ifndef RK915_COMPAT_6_15_H
+#define RK915_COMPAT_6_15_H
+#include <linux/version.h>
+#include <linux/timer.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0)
+#define del_timer(t)       timer_delete(t)
+#define del_timer_sync(t)  timer_delete_sync(t)
+#endif
+#endif
