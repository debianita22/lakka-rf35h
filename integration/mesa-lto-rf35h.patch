Subject: mesa: LTO (il driver Panfrost in userspace e\x27 il percorso di ogni frame)

---
--- a/packages/graphics/mesa/package.mk
+++ b/packages/graphics/mesa/package.mk
@@ -11,6 +11,11 @@
 PKG_DEPENDS_HOST="toolchain:host expat:host libclc:host libdrm:host Mako:host pyyaml:host spirv-tools:host"
 PKG_DEPENDS_TARGET="toolchain expat libdrm Mako:host pyyaml:host"
 PKG_LONGDESC="Mesa is a 3-D graphics library with an API."
+# devaOS RF35H: LTO sul driver GPU in userspace (Panfrost). Mesa la
+# costruiscono con LTO Fedora e Arch da anni; qui il codice che disegna ogni
+# frame di RetroArch passa di qua. Con --buildtype=plain i flag arrivano
+# dall'ambiente, e +lto-parallel li mette in CFLAGS e LDFLAGS.
+PKG_BUILD_FLAGS="+lto-parallel"
 
 get_graphicdrivers
 
