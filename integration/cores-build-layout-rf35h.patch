+# non porta: come prima, senza ottimizzatore
 
 if [ "${OPENGL_SUPPORT}" = "yes" ]; then
   PKG_DEPENDS_TARGET+=" ${OPENGL}"
diff -ruN a/packages/lakka/libretro_cores/fbneo/package.mk b/packages/lakka/libretro_cores/fbneo/package.mk
--- a/packages/lakka/libretro_cores/fbneo/package.mk	2026-10-08 21:34:32.874544413 +0200
+++ b/packages/lakka/libretro_cores/fbneo/package.mk	2026-10-08 21:34:47.426373875 +0200
@@ -19,6 +19,14 @@
   PKG_MAKE_OPTS_TARGET+=" profile=accuracy"
 fi
 
+# rf35h: dall'ottobre 2026 FBNeo ha un meson.build nella radice, e allora
+# LibreELEC compila in .${TARGET_NAME}: il -C src/burner/libretro qui sopra e
+# i percorsi di makeinstall_target sono relativi alla radice del sorgente.
+# Si torna li', che ci sia o no il meson.build.
+pre_make_target() {
+  cd "${PKG_BUILD}"
+}
+
 makeinstall_target() {
   mkdir -p ${INSTALL}/usr/lib/libretro
     cp -v src/burner/libretro/fbneo_libretro.so ${INSTALL}/usr/lib/libretro/
diff -ruN a/packages/lakka/libretro_cores/higan_sfc_balanced/package.mk b/packages/lakka/libretro_cores/higan_sfc_balanced/package.mk
--- a/packages/lakka/libretro_cores/higan_sfc_balanced/package.mk	2026-10-08 21:34:32.884400982 +0200
+++ b/packages/lakka/libretro_cores/higan_sfc_balanced/package.mk	2026-10-08 21:34:47.426496811 +0200
@@ -16,7 +16,13 @@
   PKG_MAKE_OPTS_TARGET+=" compiler=${CXX}"
 }
 
+# rf35h: dal 2026 nSide chiama il .so nside_sfc_balanced_libretro.so; si
+# installa col nome di sempre, quello del core info e delle playlist
 makeinstall_target() {
   mkdir -p ${INSTALL}/usr/lib/libretro
+  if [ -f nSide/out/nside_sfc_balanced_libretro.so ]; then
+    cp -v nSide/out/nside_sfc_balanced_libretro.so ${INSTALL}/usr/lib/libretro/higan_sfc_balanced_libretro.so
+  else
     cp -v nSide/out/higan_sfc_balanced_libretro.so ${INSTALL}/usr/lib/libretro/
+  fi
 }
diff -ruN a/packages/lakka/libretro_cores/mgba_fork/package.mk b/packages/lakka/libretro_cores/mgba_fork/package.mk
--- a/packages/lakka/libretro_cores/mgba_fork/package.mk	2026-10-08 21:47:37.486591052 +0200
+++ b/packages/lakka/libretro_cores/mgba_fork/package.mk	2026-10-08 23:22:17.883047381 +0200
@@ -3,21 +3,46 @@
 PKG_LICENSE="MPLv2.0"
 PKG_SITE="https://github.com/libretro/mgba"
 PKG_URL="${PKG_SITE}.git"
-PKG_DEPENDS_TARGET="toolchain"
+PKG_DEPENDS_TARGET="toolchain libpng zlib"
 PKG_LONGDESC="mGBA Game Boy Advance Emulator"
-PKG_TOOLCHAIN="make"
+# rf35h: da settembre 2026 libretro/mgba non ha piu' Makefile.libretro: si
+# costruisce con il CMake di mGBA (BUILD_LIBRETRO), come il core mgba di
+# Lakka, che c'era anche nei commit di prima; il .so si installa col nome
+# di sempre, mgba_fork_libretro.so. Lo zip col minizip che mGBA porta con
+# se' (dentro zlib), senza cercare libzip o minizip nel sistema: la prima
+# prova (run 37839564864) si e' fermata su "minizip/zip.h: No such file"
+PKG_TOOLCHAIN="cmake"
 
-PKG_MAKE_OPTS_TARGET="-C ../ -f Makefile.libretro"
+PKG_CMAKE_OPTS_TARGET="-DCMAKE_BUILD_TYPE=Release \
+                       -DBUILD_LIBRETRO=ON \
+                       -DSKIP_LIBRARY=ON \
+                       -DBUILD_QT=OFF \
+                       -DBUILD_SDL=OFF \
+                       -DUSE_DISCORD_RPC=OFF \
+                       -DUSE_EDITLINE=OFF \
+                       -DUSE_EPOXY=OFF \
+                       -DUSE_LIBZIP=OFF \
+                       -DUSE_MINIZIP=OFF \
+                       -DCMAKE_POLICY_VERSION_MINIMUM=3.5"
 
 if [ "${OPENGL_SUPPORT}" = "yes" ]; then
   PKG_DEPENDS_TARGET+=" ${OPENGL}"
+  PKG_CMAKE_OPTS_TARGET+=" -DBUILD_GL=ON"
+elif [ "${OPENGL_SUPPORT}" = "no" ]; then
+  PKG_CMAKE_OPTS_TARGET+=" -DBUILD_GL=OFF"
 fi
 
 if [ "${OPENGLES_SUPPORT}" = "yes" ]; then
   PKG_DEPENDS_TARGET+=" ${OPENGLES}"
+  get_graphicdrivers
+  if listcontains "${GRAPHIC_DRIVERS}" "(panfrost|vc4)"; then
+    PKG_CMAKE_OPTS_TARGET+=" -DBUILD_GLES3=ON -DBUILD_GLES2=OFF"
+  else
+    PKG_CMAKE_OPTS_TARGET+=" -DBUILD_GLES3=OFF -DBUILD_GLES2=ON"
+  fi
 fi
 
 makeinstall_target() {
   mkdir -p ${INSTALL}/usr/lib/libretro
-    cp -v ../mgba_libretro.so ${INSTALL}/usr/lib/libretro/mgba_fork_libretro.so
+    cp -v mgba_libretro.so ${INSTALL}/usr/lib/libretro/mgba_fork_libretro.so
 }
