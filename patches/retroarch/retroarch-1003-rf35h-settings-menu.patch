+/* Scraper: parte in background; se sta girando, la stessa voce lo ferma. */
+static int action_ok_rf35h_scrape(const char *path,
+      const char *label, unsigned type, size_t idx, size_t entry_idx)
+{
+   settings_t *settings = config_get_ptr();
+   const char *msg      = NULL;
+   (void)path; (void)label; (void)type; (void)idx; (void)entry_idx;
+   /* Sta girando? Lo dice systemd: il link invocation:<unit> esiste solo
+    * mentre la unit e' attiva. Il file di stato dopo un crash puo' mentire. */
+   if (path_is_valid("/run/systemd/units/invocation:rf35h-scrape.service"))
+   {
+      if (system("systemctl stop rf35h-scrape.service >/dev/null 2>&1")) { }
+      msg = "Scraping stopped";
+   }
+   else if (!path_is_valid("/storage/.config/rf35h/scraper.conf"))
+      msg = "No ScreenScraper credentials: run rf35h-scrape --init over ssh and fill scraper.conf";
+   else
+   {
+      FILE *a = fopen("/storage/.config/rf35h/scraper.args", "w");
+      if (a)
+      {
+         fprintf(a, "SCRAPE_ARGS=--region %s%s\n",
+               settings->arrays.rf35h_scrape_region,
+               settings->bools.rf35h_scrape_missing ? "" : " --all");
+         fclose(a);
+      }
+      if (system("systemctl start rf35h-scrape.service >/dev/null 2>&1")) { }
+      msg = "Scraping started, progress in Device Settings";
+   }
+   runloop_msg_queue_push(msg, strlen(msg), 1, 180, true, NULL,
+         MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+   return 0;
+}
+/* Aggiornamento di sistema: rf35h-update con la sua unit, come lo scraper.
+ * Se sta girando, la stessa voce lo ferma (il file a meta' resta, il giro
+ * dopo riprende). Con un aggiornamento pronto in /storage/.update riavvia:
+ * l'init lo installa all'avvio. */
+static int action_ok_rf35h_update(const char *path,
+      const char *label, unsigned type, size_t idx, size_t entry_idx)
+{
+   const char *msg = NULL;
+   char ready[PATH_MAX_LENGTH];
+   FILE *f;
+   (void)path; (void)label; (void)type; (void)idx; (void)entry_idx;
+   ready[0] = '\0';
+   if (path_is_valid("/run/systemd/units/invocation:rf35h-update.service"))
+   {
+      if (system("systemctl stop rf35h-update.service >/dev/null 2>&1")) { }
+      msg = "System update stopped: select again to resume";
+   }
+   else
+   {
+      if ((f = fopen("/storage/.config/rf35h/update.ready", "r")))
+      {
+         if (!fgets(ready, sizeof(ready), f))
+            ready[0] = '\0';
+         fclose(f);
+         ready[strcspn(ready, "\r\n")] = '\0';
+      }
+      /* pronto e ancora li': si riavvia (CMD_EVENT_REBOOT salva la
+       * configurazione, come il riavvio del menu) */
+      if (ready[0] && path_is_valid(ready))
+      {
+         command_event(CMD_EVENT_REBOOT, NULL);
+         return 0;
+      }
+      if (system("systemctl start rf35h-update.service >/dev/null 2>&1")) { }
+      msg = "Checking for updates, progress below the menu entry";
+   }
+   runloop_msg_queue_push(msg, strlen(msg), 1, 180, true, NULL,
+         MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+   return 0;
+}
