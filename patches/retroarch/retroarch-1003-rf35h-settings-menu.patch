+   f = filestream_open(RF35H_STATE_DIR "/brightness", RETRO_VFS_FILE_ACCESS_WRITE, RETRO_VFS_FILE_ACCESS_HINT_NONE);
+   if (f)
+   {
+      filestream_printf(f, "%u\n", p);
+      filestream_close(f);
+   }
+}
