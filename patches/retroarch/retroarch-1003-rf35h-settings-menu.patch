+/* Lo stato dello scraper nel sottotitolo: idle, running n/m, done, error. */
+static int action_bind_sublabel_rf35h_scrape(
+      file_list_t *list, unsigned type, unsigned i,
+      const char *label, const char *path,
+      char *s, size_t len)
+{
+   /* Ozone chiama questo callback a ogni frame: il file si rilegge al
+    * massimo due volte al secondo, il resto e' cache. */
+   static char st[96];
+   static retro_time_t last_read = 0;
+   retro_time_t now = cpu_features_get_time_usec();
+   if (!last_read || now - last_read > 500000)
+   {
+      FILE *f   = fopen("/storage/.config/rf35h/scraper.status", "r");
+      last_read = now;
+      st[0]     = '\0';
+      if (f)
+      {
+         if (fgets(st, sizeof(st), f))
+            string_remove_all_chars(st, '\n');
+         else
+            st[0] = '\0';
+         fclose(f);
+      }
+      if (!strncmp(st, "running", 7) &&
+          !path_is_valid("/run/systemd/units/invocation:rf35h-scrape.service"))
+         strlcpy(st, "interrupted (select to start again)", sizeof(st));
+   }
+   snprintf(s, len, "%s\n%s", msg_hash_to_str(MENU_ENUM_SUBLABEL_RF35H_SCRAPE),
+         st[0] ? st : "idle");
+   return 1;
+}
+/* Lo stato dell'aggiornamento: la riga che scrive rf35h-update, o la
+ * versione installata (VERSION di /etc/os-release) se non c'e' niente in
+ * corso. Riletta al massimo due volte al secondo, come quella dello scraper. */
+static int action_bind_sublabel_rf35h_update(
+      file_list_t *list, unsigned type, unsigned i,
+      const char *label, const char *path,
+      char *s, size_t len)
+{
+   static char st[112];
+   static retro_time_t last_read = 0;
+   retro_time_t now = cpu_features_get_time_usec();
+   if (!last_read || now - last_read > 500000)
+   {
+      FILE *f   = fopen("/storage/.config/rf35h/update.status", "r");
+      last_read = now;
+      st[0]     = '\0';
+      if (f)
+      {
+         if (fgets(st, sizeof(st), f))
+            string_remove_all_chars(st, '\n');
+         else
+            st[0] = '\0';
+         fclose(f);
+      }
+      /* a meta' ma senza il servizio: fermato, o RetroArch riavviato */
+      if ((!strncmp(st, "checking", 8) || !strncmp(st, "downloading", 11)
+               || !strncmp(st, "verifying", 9))
+            && !path_is_valid("/run/systemd/units/invocation:rf35h-update.service"))
+         strlcpy(st, "interrupted: select to resume", sizeof(st));
+      if (!st[0])
+      {
+         char line[128];
+         FILE *o = fopen("/etc/os-release", "r");
+         strlcpy(st, "installed: ?", sizeof(st));
+         if (o)
+         {
+            while (fgets(line, sizeof(line), o))
+            {
+               if (!strncmp(line, "VERSION=", 8))
+               {
+                  string_remove_all_chars(line, '"');
+                  string_remove_all_chars(line, '\n');
+                  snprintf(st, sizeof(st), "installed: %s", line + 8);
+                  break;
+               }
+            }
+            fclose(o);
+         }
+      }
+   }
+   snprintf(s, len, "%s\n%s", msg_hash_to_str(MENU_ENUM_SUBLABEL_RF35H_UPDATE), st);
+   return 1;
+}
+#endif
