-static void systemd_service_toggle(const char *path, char *unit, bool enable)
+#include <errno.h>
+#include <sys/wait.h>
+/* devaOS RF35H: "systemctl start|stop <unit>" senza aspettarlo e senza
+ * zombie. Il codice originale faceva fork() e non raccoglieva mai il figlio:
+ * uno zombie a ogni toggle, fino all'uscita di RetroArch. Doppio fork: il
+ * figlio intermedio esce subito e lo si raccoglie qui (un istante), il nipote
+ * esegue systemctl, resta orfano e lo raccoglie init. */
+static void systemd_service_spawn(char *verb, char *unit)
 {
+   char *args[] = {(char*)"systemctl", verb, unit, NULL};
    pid_t pid    = fork();
-   char* args[] = {(char*)"systemctl",
-                   enable ? (char*)"start" : (char*)"stop",
-                   unit,
-                   NULL};
 
    if (pid == 0)
    {
-      if (enable)
-         filestream_close(filestream_open(path,
-                  RETRO_VFS_FILE_ACCESS_WRITE,
-                  RETRO_VFS_FILE_ACCESS_HINT_NONE));
-      else
-         filestream_delete(path);
-
-      execvp(args[0], args);
+      if (fork() == 0)
+      {
+         execvp(args[0], args);
+         _exit(127);
+      }
+      _exit(0);
    }
+   if (pid > 0)
+      while (waitpid(pid, NULL, 0) < 0 && errno == EINTR) { }
+}
+
+static void systemd_service_toggle(const char *path, char *unit, bool enable)
+{
+   /* devaOS RF35H: rinomina invece di svuotare o cancellare, vedi
+    * config_set_service_state() in configuration.c. Qui, prima del fork: nel
+    * figlio due toggle ravvicinati (Start sul toggle chiama il gestore due
+    * volte) correvano sullo stesso file, e chi perdeva troncava il .conf
+    * appena rimesso a posto dall'altro. */
+   config_set_service_state(path, enable);
+   systemd_service_spawn(enable ? (char*)"start" : (char*)"stop", unit);
 }
 
