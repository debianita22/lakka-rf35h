-               RETRO_VFS_FILE_ACCESS_HINT_NONE));
-   else
-      filestream_delete(LAKKA_BLUETOOTH_PATH);
+   config_set_service_state(LAKKA_SSH_PATH, settings->bools.ssh_enable);
+   /* devaOS RF35H: finche' rf35h-usb tiene da parte il flag di Samba (porta
+    * USB-C in "transfer"), la scelta dell'utente e' quel file, e il flag non
