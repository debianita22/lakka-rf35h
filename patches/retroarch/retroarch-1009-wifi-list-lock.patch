+/* devaOS RF35H: la rete scelta, per id di connman. I task Wi-Fi ricostruiscono
+ * la lista mentre si digita la password (una scansione ogni 30 s, e connman
+ * ordina per segnale): l'indice salvato all'apertura della finestra poteva
+ * indicare un'altra rete, che riceveva la password - e se la connessione
+ * falliva, connect_ssid cancellava la sua configurazione salvata. */
+static char menu_wifi_dialog_netid[160];
+
+/* Copia, sotto lock, la voce con quell'id (o, se l'id e' NULL, con quell'indice).
+ * Si lavora sulla copia: il lock non resta preso mentre si accoda il task. */
+static bool menu_wifi_snapshot(size_t idx, const char *netid,
+      wifi_network_info_t *out)
+{
+   size_t i;
+   bool found                = false;
+   wifi_network_scan_t *scan = driver_wifi_get_ssids();
+
+   if (!scan)
+      return false;
+
+   driver_wifi_list_lock();
+   for (i = 0; i < RBUF_LEN(scan->net_list); i++)
+   {
+      if (netid ? string_is_equal(scan->net_list[i].netid, netid) : (i == idx))
+      {
+         memcpy(out, &scan->net_list[i], sizeof(*out));
+         found = true;
+         break;
+      }
+   }
+   driver_wifi_list_unlock();
+
+   return found;
+}
