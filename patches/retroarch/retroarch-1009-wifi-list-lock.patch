    return false;
 }
 
+/* devaOS RF35H: vedi wifi_driver.h. Mutex inizializzato staticamente: esiste
+ * prima di qualunque task e non viene mai distrutto, quindi un task ancora
+ * in corso alla chiusura non puo' trovarlo liberato. Solo Linux: altrove non
+ * ci sono driver Wi-Fi che ricostruiscono la lista in un altro thread. */
+#if defined(HAVE_THREADS) && defined(__linux__)
+#include <pthread.h>
+static pthread_mutex_t wifi_list_mutex = PTHREAD_MUTEX_INITIALIZER;
+#endif
+
+void driver_wifi_list_lock(void)
+{
+#if defined(HAVE_THREADS) && defined(__linux__)
+   pthread_mutex_lock(&wifi_list_mutex);
+#endif
+}
+
+void driver_wifi_list_unlock(void)
+{
+#if defined(HAVE_THREADS) && defined(__linux__)
+   pthread_mutex_unlock(&wifi_list_mutex);
+#endif
+}
+
